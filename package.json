{
  "name": "beaver-security",
  "version": "2.0.1",
  "private": true,
  "description": "Open-source network security monitor for Windows and Linux: live connections, threat intelligence, remote-access and data-theft detection, native firewall control.",
  "license": "Apache-2.0",
  "author": {
    "name": "Amogh Shukla",
    "email": "169269488+AmoghShukla06@users.noreply.github.com",
    "url": "https://github.com/AmoghShukla06"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "service:build": "node scripts/stage-service.cjs",
    "tauri:dev": "node scripts/msvc.cjs npx tauri dev",
    "tauri:debug": "node scripts/msvc.cjs npx tauri build --debug --no-bundle",
    "tauri:build": "node scripts/msvc.cjs npx tauri build",
    "test:service": "node scripts/stage-service.cjs && node scripts/msvc.cjs cargo test --workspace",
    "test:app": "node scripts/test-tauri.cjs",
    "test": "npm run test:service && npm run tauri:debug && npm run test:app",
    "format": "prettier --write src scripts vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.11.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "homepage": "https://github.com/AmoghShukla06/Beaver",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmoghShukla06/Beaver.git"
  },
  "bugs": {
    "url": "https://github.com/AmoghShukla06/Beaver/issues"
  },
  "keywords": [
    "network-monitor",
    "security",
    "firewall",
    "threat-intelligence",
    "electron",
    "windows",
    "linux",
    "remote-access",
    "infostealer"
  ]
}
