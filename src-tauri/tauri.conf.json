{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beaver",
  "version": "2.0.1",
  "identifier": "org.beaver.security",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "node scripts/stage-service.cjs && npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/stage-service.cjs"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Amogh Shukla",
    "copyright": "Copyright © 2026 Amogh Shukla and Beaver contributors",
    "category": "Utility",
    "shortDescription": "Network security monitor",
    "longDescription": "See every connection, detect remote access and data theft, and block threats with native firewall rules.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/AmoghShukla06/Beaver",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/beaver-service"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../packaging/installer-header.bmp",
        "sidebarImage": "../packaging/installer-sidebar.bmp",
        "displayLanguageSelector": false,
        "template": "../packaging/installer.nsi"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"],
        "recommends": ["libpcap0.8", "nftables", "policykit-1", "libcap2-bin"],
        "conflicts": ["beaver-security"],
        "replaces": ["beaver-security"],
        "postInstallScript": "../packaging/linux/postinst.sh",
        "postRemoveScript": "../packaging/linux/postrm.sh"
      },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
